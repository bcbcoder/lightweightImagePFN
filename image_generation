def make_gaussian_kernel(kernel_size, sigma, channels, device):
    assert kernel_size % 2 == 1

    radius = kernel_size // 2
    coords = torch.arange(-radius, radius + 1, device=device).float()
    yy, xx = torch.meshgrid(coords, coords, indexing="ij")

    kernel = torch.exp(-(xx ** 2 + yy ** 2) / (2.0 * sigma ** 2))
    kernel = kernel / kernel.sum()

    kernel = kernel.view(1, 1, kernel_size, kernel_size)
    kernel = kernel.repeat(channels, 1, 1, 1)

    return kernel


def gaussian_blur(x, kernel_size=3, sigma=0.8):
    _B, C, _H, _W = x.shape

    kernel = make_gaussian_kernel(
        kernel_size=kernel_size,
        sigma=sigma,
        channels=C,
        device=x.device,
    )

    x = F.conv2d(
        x,
        kernel,
        padding=kernel_size // 2,
        groups=C,
    )

    return x


def gaussian_downsample_once(x, kernel_size=5, sigma=1.0):
    x = gaussian_blur(
        x,
        kernel_size=kernel_size,
        sigma=sigma,
    )

    x = F.interpolate(
        x,
        scale_factor=0.5,
        mode="bilinear",
        align_corners=False,
    )

    return x


def gaussian_downsample_steps(x, steps, kernel_size=5, sigma=1.0):
    current = x

    for _ in range(int(steps)):
        current = gaussian_downsample_once(
            current,
            kernel_size=kernel_size,
            sigma=sigma,
        )

    return current


def build_image_pyramid(imgs):
    """
    Builds analyzed image levels:

        L0: 64x64
        L1: 16x16
    """
    pyramid = []

    for steps in DOWNSAMPLE_STEPS_PER_LEVEL:
        x_level = gaussian_downsample_steps(
            imgs,
            steps=steps,
            kernel_size=5,
            sigma=1.0,
        )
        pyramid.append(x_level)

    return pyramid


def rgb_01(x):
    return ((x + 1.0) / 2.0).clamp(0.0, 1.0)


def rgb_to_gray_01(x):
    x = rgb_01(x)

    gray = (
        0.2989 * x[:, 0:1]
        + 0.5870 * x[:, 1:2]
        + 0.1140 * x[:, 2:3]
    )

    return gray


def rgb_to_hsv_01(x, eps=1e-6):
    """
    Differentiable-ish RGB to HSV for x in [-1, 1].
    Returns HSV in [0, 1]. Hue has piecewise max-channel logic, which is fine
    for this frozen feature loss use case.
    """
    rgb = rgb_01(x)
    r = rgb[:, 0:1]
    g = rgb[:, 1:2]
    b = rgb[:, 2:3]

    maxc, _ = rgb.max(dim=1, keepdim=True)
    minc, _ = rgb.min(dim=1, keepdim=True)
    delta = maxc - minc

    v = maxc
    s = delta / (maxc + eps)

    hr = torch.remainder((g - b) / (delta + eps), 6.0)
    hg = ((b - r) / (delta + eps)) + 2.0
    hb = ((r - g) / (delta + eps)) + 4.0

    is_r = (maxc == r).float()
    is_g = (maxc == g).float()
    is_b = (maxc == b).float()

    h = (is_r * hr + is_g * hg + is_b * hb) / 6.0
    h = torch.remainder(h, 1.0)
    h = torch.where(delta > eps, h, torch.zeros_like(h))

    return torch.cat([h, s, v], dim=1)


def soft_histogram_01(values, bins, eps=1e-6):
    """
    Soft triangular histogram for values in [0, 1].
    values: [B, 1, H, W]
    output: [B, bins]
    """
    B = values.shape[0]
    centers = torch.linspace(0.0, 1.0, steps=bins, device=values.device).view(1, bins, 1, 1)
    width = 1.0 / max(float(bins - 1), 1.0)
    weights = F.relu(1.0 - torch.abs(values - centers) / (width + eps))
    hist = weights.mean(dim=(2, 3))
    hist = hist / (hist.sum(dim=1, keepdim=True) + eps)
    return hist.view(B, bins)


