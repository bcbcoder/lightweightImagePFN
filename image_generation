# Wavelet-tied generator
# ============================================================

def make_wavelet_bank(device):
    filters = []

    filters.append(torch.tensor([[-1, -1, -1],
                                 [ 0,  0,  0],
                                 [ 1,  1,  1]], dtype=torch.float32))

    filters.append(torch.tensor([[-1, 0, 1],
                                 [-1, 0, 1],
                                 [-1, 0, 1]], dtype=torch.float32))

    filters.append(torch.tensor([[ 0,  1,  1],
                                 [-1,  0,  1],
                                 [-1, -1,  0]], dtype=torch.float32))

    filters.append(torch.tensor([[ 1,  1,  0],
                                 [ 1,  0, -1],
                                 [ 0, -1, -1]], dtype=torch.float32))

    filters.append(torch.tensor([[ 0, -1,  0],
                                 [-1,  4, -1],
                                 [ 0, -1,  0]], dtype=torch.float32))

    filters.append(torch.tensor([[-1, -1, -1],
                                 [-1,  8, -1],
                                 [-1, -1, -1]], dtype=torch.float32))

    bank = torch.stack(filters, dim=0).to(device)
    bank = bank / (bank.flatten(1).norm(dim=1).view(-1, 1, 1) + 1e-8)
    return bank


class TiedWaveletConv2d(nn.Module):
    def __init__(self, in_channels, out_channels, trainable=True):
        super().__init__()

        self.in_channels = in_channels
        self.out_channels = out_channels

        self.amplitude = nn.Parameter(
            torch.randn(out_channels, in_channels, 1, 1) * 0.8,
            requires_grad=trainable,
        )

        self.bias = nn.Parameter(
            torch.zeros(out_channels),
            requires_grad=trainable,
        )

        self.register_buffer(
            "wavelet_indices",
            torch.empty(in_channels, dtype=torch.long),
        )

    def reset_wavelets(self, bank_size, device):
        self.wavelet_indices = torch.randint(
            low=0,
            high=bank_size,
            size=(self.in_channels,),
            device=device,
        )

    def forward(self, x, wavelet_bank):
        selected = wavelet_bank[self.wavelet_indices]
        selected = selected.unsqueeze(0)
        weight = self.amplitude * selected
        return F.conv2d(x, weight, bias=self.bias, padding=1)


class OrientedBlock(nn.Module):
    def __init__(self, in_ch, out_ch, trainable=True):
        super().__init__()

        self.conv = TiedWaveletConv2d(in_ch, out_ch, trainable=trainable)
        self.to_style = nn.Linear(512, out_ch)
        self.norm = nn.InstanceNorm2d(out_ch, affine=False)
        self.act = nn.LeakyReLU(0.2, inplace=True)

    def reset_wavelets(self, bank_size, device):
        self.conv.reset_wavelets(bank_size, device)

    def forward(self, x, w, wavelet_bank):
        x = self.conv(x, wavelet_bank)
        x = self.norm(x)

        style = self.to_style(w).view(w.shape[0], -1, 1, 1)
        x = x * (1.0 + style)

        x = self.act(x)
        return x


class StyleGANOrientedGenerator(nn.Module):
    def __init__(
        self,
        z_dim=256,
        vector_dim=78,
        image_size=64,
        base_channels=384,
        trainable=True,
    ):
        super().__init__()

        assert image_size in [32, 64, 128, 256]

        self.z_dim = z_dim
        self.vector_dim = vector_dim
        self.image_size = image_size

        input_dim = z_dim + vector_dim

        self.mapping = nn.Sequential(
            nn.Linear(input_dim, 512),
            nn.LeakyReLU(0.2, inplace=True),
            nn.Linear(512, 512),
            nn.LeakyReLU(0.2, inplace=True),
            nn.Linear(512, 512),
        )

        self.const = nn.Parameter(
            torch.randn(1, base_channels, 4, 4),
            requires_grad=trainable,
        )

        channels = {
            4: base_channels,
            8: base_channels,
            16: base_channels // 2,
            32: base_channels // 4,
            64: base_channels // 8,
            128: base_channels // 16,
            256: base_channels // 32,
        }

        blocks = []
        res = 8
        in_ch = channels[4]

        while res <= image_size:
            out_ch = max(channels[res], 16)
            blocks.append(OrientedBlock(in_ch, out_ch, trainable=trainable))
            in_ch = out_ch
            res *= 2

        self.blocks = nn.ModuleList(blocks)
        self.to_rgb = nn.Conv2d(in_ch, 3, kernel_size=1)

        self.register_buffer("wavelet_bank", torch.empty(1))

    def reset_wavelets(self, device):
        self.wavelet_bank = make_wavelet_bank(device)
        bank_size = self.wavelet_bank.shape[0]

        for block in self.blocks:
            block.reset_wavelets(bank_size, device)

    def forward(self, z, y):
        inp = torch.cat([z, y], dim=1)
        w = self.mapping(inp)

        x = self.const.repeat(z.shape[0], 1, 1, 1)

        for block in self.blocks:
            x = F.interpolate(
                x,
                scale_factor=2,
                mode="bilinear",
                align_corners=False,
            )
            x = block(x, w, self.wavelet_bank)

        x = self.to_rgb(x)
        x = torch.tanh(x)
        return x


