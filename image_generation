def make_gabor_kernel_bank(
    num_orientations,
    wavelengths,
    kernel_size,
    sigma,
    gamma,
    device,
):
    assert kernel_size % 2 == 1

    radius = kernel_size // 2
    coords = torch.arange(-radius, radius + 1, device=device).float()
    yy, xx = torch.meshgrid(coords, coords, indexing="ij")

    kernels = []

    for wavelength in wavelengths:
        for ori_idx in range(num_orientations):
            theta = math.pi * float(ori_idx) / float(num_orientations)

            x_theta = xx * math.cos(theta) + yy * math.sin(theta)
            y_theta = -xx * math.sin(theta) + yy * math.cos(theta)

            envelope = torch.exp(
                -(x_theta.pow(2) + (gamma ** 2) * y_theta.pow(2))
                / (2.0 * sigma ** 2)
            )

            carrier = torch.cos(2.0 * math.pi * x_theta / float(wavelength))

            kernel = envelope * carrier
            kernel = kernel - kernel.mean()
            kernel = kernel / (kernel.norm() + 1e-8)

            kernels.append(kernel)

    bank = torch.stack(kernels, dim=0).view(len(kernels), 1, kernel_size, kernel_size)
    return bank


class FrozenGaborFeatures(nn.Module):
    def __init__(
        self,
        num_orientations=8,
        wavelengths=None,
        kernel_size=11,
        sigma=3.0,
        gamma=0.5,
        pooled_size=4,
        use_abs_response=True,
        eps=1e-6,
    ):
        super().__init__()

        if wavelengths is None:
            wavelengths = [4.0, 8.0, 16.0]

        self.num_orientations = num_orientations
        self.wavelengths = list(wavelengths)
        self.kernel_size = kernel_size
        self.sigma = sigma
        self.gamma = gamma
        self.pooled_size = pooled_size
        self.use_abs_response = use_abs_response
        self.eps = eps

        self.register_buffer("gabor_bank", torch.empty(1))

    def reset_filters(self, device):
        self.gabor_bank = make_gabor_kernel_bank(
            num_orientations=self.num_orientations,
            wavelengths=self.wavelengths,
            kernel_size=self.kernel_size,
            sigma=self.sigma,
            gamma=self.gamma,
            device=device,
        )

    def forward(self, x):
        gray = rgb_to_gray_01(x)

        responses = F.conv2d(
            gray,
            self.gabor_bank,
            padding=self.kernel_size // 2,
        )

        if self.use_abs_response:
            responses = responses.abs()

        pooled = F.adaptive_avg_pool2d(
            responses,
            output_size=(self.pooled_size, self.pooled_size),
        )

        feats = pooled.flatten(1)
        feats = F.normalize(feats, dim=1)
        return feats


class FrozenDoGBlobFeatures(nn.Module):
    def __init__(
        self,
        sigmas=None,
        kernel_size=9,
        pooled_size=4,
        include_signed=True,
        eps=1e-6,
    ):
        super().__init__()

        if sigmas is None:
            sigmas = [0.7, 1.2, 2.0, 3.2]

        assert len(sigmas) >= 2

        self.sigmas = list(sigmas)
        self.kernel_size = kernel_size
        self.pooled_size = pooled_size
        self.include_signed = include_signed
        self.eps = eps

    def forward(self, x):
        gray = rgb_to_gray_01(x)

        blurred = [
            gaussian_blur(
                gray,
                kernel_size=self.kernel_size,
                sigma=float(sigma),
            )
            for sigma in self.sigmas
        ]

        dog_maps = []

        for i in range(len(blurred) - 1):
            dog = blurred[i + 1] - blurred[i]
            dog_maps.append(dog.abs())

            if self.include_signed:
                dog_maps.append(dog)

        maps = torch.cat(dog_maps, dim=1)

        pooled = F.adaptive_avg_pool2d(
            maps,
            output_size=(self.pooled_size, self.pooled_size),
        )

        feats = pooled.flatten(1)
        feats = F.normalize(feats, dim=1)
        return feats


class FrozenFFTSpectrumFeatures(nn.Module):
    def __init__(
        self,
        image_size=64,
        radial_bins=6,
        orientation_bins=8,
        use_log_magnitude=True,
        eps=1e-6,
    ):
        super().__init__()

        self.image_size = image_size
        self.radial_bins = radial_bins
        self.orientation_bins = orientation_bins
        self.use_log_magnitude = use_log_magnitude
        self.eps = eps

        self.register_buffer("radial_masks", torch.empty(1))
        self.register_buffer("orientation_masks", torch.empty(1))
        self.register_buffer("hann2d", torch.empty(1))

    def reset_masks(self, device):
        H = self.image_size
        W = self.image_size

        fy = torch.fft.fftfreq(H, device=device).view(H, 1)
        fx = torch.fft.rfftfreq(W, device=device).view(1, W // 2 + 1)

        rr = torch.sqrt(fx.pow(2) + fy.pow(2))
        rr_max = rr.max().clamp_min(self.eps)

        theta = torch.atan2(fy, fx + self.eps)
        theta = torch.remainder(theta, math.pi)

        radial_edges = torch.linspace(
            0.0,
            float(rr_max.item()),
            steps=self.radial_bins + 1,
            device=device,
        )

        radial_masks = []

        for i in range(self.radial_bins):
            lo = radial_edges[i]
            hi = radial_edges[i + 1]

            if i == 0:
                mask = (rr >= lo) & (rr <= hi)
            else:
                mask = (rr > lo) & (rr <= hi)

            radial_masks.append(mask.float())

        radial_masks = torch.stack(radial_masks, dim=0)

        orientation_edges = torch.linspace(
            0.0,
            math.pi,
            steps=self.orientation_bins + 1,
            device=device,
        )

        orientation_masks = []

        for i in range(self.orientation_bins):
            lo = orientation_edges[i]
            hi = orientation_edges[i + 1]

            if i == 0:
                mask = (theta >= lo) & (theta <= hi)
            else:
                mask = (theta > lo) & (theta <= hi)

            mask = mask & (rr > 0.0)
            orientation_masks.append(mask.float())

        orientation_masks = torch.stack(orientation_masks, dim=0)

        hann_y = torch.hann_window(H, device=device).view(1, 1, H, 1)
        hann_x = torch.hann_window(W, device=device).view(1, 1, 1, W)
        hann2d = hann_y * hann_x

        self.radial_masks = radial_masks
        self.orientation_masks = orientation_masks
        self.hann2d = hann2d

    def _masked_mean(self, magnitude, masks):
        numerator = (magnitude.unsqueeze(1) * masks.unsqueeze(0)).sum(dim=(2, 3))
        denominator = masks.sum(dim=(1, 2)).clamp_min(self.eps).view(1, -1)
        return numerator / denominator

    def forward(self, x):
        gray = rgb_to_gray_01(x)

        gray = gray - gray.mean(dim=(2, 3), keepdim=True)
        gray = gray * self.hann2d

        fft = torch.fft.rfft2(gray.squeeze(1), norm="ortho")
        magnitude = fft.abs()

        if self.use_log_magnitude:
            magnitude = torch.log1p(magnitude)

        radial_feats = self._masked_mean(
            magnitude=magnitude,
            masks=self.radial_masks,
        )

        orientation_feats = self._masked_mean(
            magnitude=magnitude,
            masks=self.orientation_masks,
        )

        feats = torch.cat(
            [
                radial_feats,
                orientation_feats,
            ],
            dim=1,
        )

        feats = F.normalize(feats, dim=1)
        return feats


class FrozenSteerableGradientFeatures(nn.Module):
    def __init__(
        self,
        num_orientations=12,
        blur_kernel_size=5,
        blur_sigma=1.0,
        pooled_size=4,
        include_signed=True,
        eps=1e-6,
    ):
        super().__init__()

        self.num_orientations = num_orientations
        self.blur_kernel_size = blur_kernel_size
        self.blur_sigma = blur_sigma
        self.pooled_size = pooled_size
        self.include_signed = include_signed
        self.eps = eps

        gx = torch.tensor(
            [[-1, 0, 1],
             [-2, 0, 2],
             [-1, 0, 1]],
            dtype=torch.float32,
        ).view(1, 1, 3, 3)

        gy = torch.tensor(
            [[-1, -2, -1],
             [ 0,  0,  0],
             [ 1,  2,  1]],
            dtype=torch.float32,
        ).view(1, 1, 3, 3)

        self.register_buffer("sobel_x", gx)
        self.register_buffer("sobel_y", gy)

        angles = torch.linspace(
            0.0,
            math.pi,
            steps=num_orientations + 1,
            dtype=torch.float32,
        )[:-1]
        self.register_buffer("angles", angles)

    def forward(self, x):
        gray = rgb_to_gray_01(x)
        gray = gaussian_blur(gray, kernel_size=self.blur_kernel_size, sigma=self.blur_sigma)

        gx = F.conv2d(gray, self.sobel_x, padding=1)
        gy = F.conv2d(gray, self.sobel_y, padding=1)

        responses = []
        for theta in self.angles:
            resp = math.cos(float(theta.item())) * gx + math.sin(float(theta.item())) * gy
            responses.append(resp.abs())
            if self.include_signed:
                responses.append(resp)

        maps = torch.cat(responses, dim=1)
        pooled = F.adaptive_avg_pool2d(maps, output_size=(self.pooled_size, self.pooled_size))
        feats = pooled.flatten(1)
        feats = F.normalize(feats, dim=1)
        return feats


class FrozenHSVColorFeatures(nn.Module):
    def __init__(
        self,
        h_bins=12,
        s_bins=6,
        v_bins=6,
        pooled_size=4,
        eps=1e-6,
    ):
        super().__init__()

        self.h_bins = h_bins
        self.s_bins = s_bins
        self.v_bins = v_bins
        self.pooled_size = pooled_size
        self.eps = eps

    def forward(self, x):
        rgb = rgb_01(x)
        hsv = rgb_to_hsv_01(x, eps=self.eps)

        h = hsv[:, 0:1]
        s = hsv[:, 1:2]
        v = hsv[:, 2:3]

        h_hist = soft_histogram_01(h, bins=self.h_bins, eps=self.eps)
        s_hist = soft_histogram_01(s, bins=self.s_bins, eps=self.eps)
        v_hist = soft_histogram_01(v, bins=self.v_bins, eps=self.eps)

        rgb_mean = rgb.mean(dim=(2, 3))
        rgb_std = rgb.std(dim=(2, 3), unbiased=False)
        hsv_mean = hsv.mean(dim=(2, 3))
        hsv_std = hsv.std(dim=(2, 3), unbiased=False)

        pooled_hsv = F.adaptive_avg_pool2d(hsv, output_size=(self.pooled_size, self.pooled_size)).flatten(1)

        feats = torch.cat(
            [
                h_hist,
                s_hist,
                v_hist,
                rgb_mean,
                rgb_std,
                hsv_mean,
                hsv_std,
                pooled_hsv,
            ],
            dim=1,
        )
        feats = F.normalize(feats, dim=1)
        return feats


class FrozenSoftLBPFeatures(nn.Module):
    def __init__(
        self,
        sharpness=12.0,
        pooled_size=4,
        include_code_stats=True,
        eps=1e-6,
    ):
        super().__init__()

        self.sharpness = sharpness
        self.pooled_size = pooled_size
        self.include_code_stats = include_code_stats
        self.eps = eps

        weights = torch.tensor([1, 2, 4, 8, 16, 32, 64, 128], dtype=torch.float32)
        self.register_buffer("bit_weights", weights.view(1, 8, 1, 1) / 255.0)

    def forward(self, x):
        gray = rgb_to_gray_01(x)

        padded = F.pad(gray, pad=(1, 1, 1, 1), mode="reflect")
        center = padded[:, :, 1:-1, 1:-1]

        neighbors = [
            padded[:, :, 0:-2, 0:-2],
            padded[:, :, 0:-2, 1:-1],
            padded[:, :, 0:-2, 2:  ],
            padded[:, :, 1:-1, 2:  ],
            padded[:, :, 2:  , 2:  ],
            padded[:, :, 2:  , 1:-1],
            padded[:, :, 2:  , 0:-2],
            padded[:, :, 1:-1, 0:-2],
        ]

        soft_bits = [torch.sigmoid(self.sharpness * (n - center)) for n in neighbors]
        bits = torch.cat(soft_bits, dim=1)

        code = (bits * self.bit_weights).sum(dim=1, keepdim=True)

        pooled_bits = F.adaptive_avg_pool2d(bits, output_size=(self.pooled_size, self.pooled_size)).flatten(1)
        pooled_code = F.adaptive_avg_pool2d(code, output_size=(self.pooled_size, self.pooled_size)).flatten(1)

        feats = [pooled_bits, pooled_code]

        if self.include_code_stats:
            feats.extend([
                bits.mean(dim=(2, 3)),
                bits.std(dim=(2, 3), unbiased=False),
                code.mean(dim=(2, 3)),
                code.std(dim=(2, 3), unbiased=False),
            ])

        feats = torch.cat(feats, dim=1)
        feats = F.normalize(feats, dim=1)
        return feats


class FrozenShapeEdgeFeatures(nn.Module):
    def __init__(
        self,
        orientation_bins=12,
        pooled_size=4,
        blur_kernel_size=3,
        blur_sigma=0.6,
        eps=1e-6,
    ):
        super().__init__()

        self.orientation_bins = orientation_bins
        self.pooled_size = pooled_size
        self.blur_kernel_size = blur_kernel_size
        self.blur_sigma = blur_sigma
        self.eps = eps

        gx = torch.tensor(
            [[-1, 0, 1],
             [-2, 0, 2],
             [-1, 0, 1]],
            dtype=torch.float32,
        ).view(1, 1, 3, 3)

        gy = torch.tensor(
            [[-1, -2, -1],
             [ 0,  0,  0],
             [ 1,  2,  1]],
            dtype=torch.float32,
        ).view(1, 1, 3, 3)

        lap = torch.tensor(
            [[0,  1, 0],
             [1, -4, 1],
             [0,  1, 0]],
            dtype=torch.float32,
        ).view(1, 1, 3, 3)

        self.register_buffer("sobel_x", gx)
        self.register_buffer("sobel_y", gy)
        self.register_buffer("laplacian", lap)

        centers = torch.linspace(0.0, math.pi, steps=orientation_bins + 1, dtype=torch.float32)[:-1]
        self.register_buffer("bin_centers", centers.view(1, orientation_bins, 1, 1))
        self.bin_width = math.pi / float(orientation_bins)

    def forward(self, x):
        gray = rgb_to_gray_01(x)
        gray = gaussian_blur(gray, kernel_size=self.blur_kernel_size, sigma=self.blur_sigma)

        gx = F.conv2d(gray, self.sobel_x, padding=1)
        gy = F.conv2d(gray, self.sobel_y, padding=1)
        lap = F.conv2d(gray, self.laplacian, padding=1)

        edge_mag = torch.sqrt(gx.pow(2) + gy.pow(2) + self.eps)
        angle = torch.remainder(torch.atan2(gy, gx), math.pi)

        diff = torch.abs(angle - self.bin_centers)
        circular_diff = torch.minimum(diff, math.pi - diff)
        ori_weights = F.relu(1.0 - circular_diff / (self.bin_width + self.eps))
        ori_votes = edge_mag * ori_weights

        # Structure-tensor style shape cues.
        jxx = gaussian_blur(gx * gx, kernel_size=3, sigma=0.6)
        jyy = gaussian_blur(gy * gy, kernel_size=3, sigma=0.6)
        jxy = gaussian_blur(gx * gy, kernel_size=3, sigma=0.6)
        coherence = torch.sqrt((jxx - jyy).pow(2) + 4.0 * jxy.pow(2) + self.eps) / (jxx + jyy + self.eps)

        pooled_ori = F.adaptive_avg_pool2d(ori_votes, output_size=(self.pooled_size, self.pooled_size)).flatten(1)
        pooled_maps = F.adaptive_avg_pool2d(
            torch.cat([edge_mag, lap.abs(), lap, coherence], dim=1),
            output_size=(self.pooled_size, self.pooled_size),
        ).flatten(1)

        global_stats = torch.cat(
            [
                edge_mag.mean(dim=(2, 3)),
                edge_mag.std(dim=(2, 3), unbiased=False),
                lap.abs().mean(dim=(2, 3)),
                coherence.mean(dim=(2, 3)),
            ],
            dim=1,
        )

        feats = torch.cat([pooled_ori, pooled_maps, global_stats], dim=1)
        feats = F.normalize(feats, dim=1)
        return feats


# ============================================================
# Similarities and losses
# ============================================================

def cosine_similarity_matrix(x):
    x = F.normalize(x, dim=1)
    return x @ x.T


def relational_loss_from_similarities(sim_img, sim_y):
    B = sim_img.shape[0]
    mask = ~torch.eye(B, dtype=torch.bool, device=sim_img.device)

    return F.mse_loss(
        sim_img[mask],
        sim_y[mask],
    )


def relative_diversity_ceiling(sim_y):
    """
    Converts target cosine similarity into a pairwise image-similarity ceiling.

        ceiling = 1 - strength * (1 - sim_y)

    Examples:
        strength = 1.0:
            sim_y  1 -> ceiling  1
            sim_y  0 -> ceiling  0
            sim_y -1 -> ceiling -1

        strength = 0.5:
            sim_y  1 -> ceiling  1
            sim_y  0 -> ceiling  0.5
            sim_y -1 -> ceiling  0
    """
    strength = float(PATTERN_DIVERSITY_STRENGTH)

    if strength < 0.0 or strength > 1.0:
        raise ValueError(
            f"PATTERN_DIVERSITY_STRENGTH must be in [0, 1], got {strength}."
        )

    ceiling = 1.0 - strength * (1.0 - sim_y)
    ceiling = torch.clamp(ceiling, min=-1.0, max=1.0)
    return ceiling


def pattern_diversity_penalty(sim_img, sim_y):
    B = sim_img.shape[0]
    off_diag_mask = ~torch.eye(B, dtype=torch.bool, device=sim_img.device)

    ceiling = relative_diversity_ceiling(sim_y)

    offending_amount = F.relu(sim_img - ceiling)
    loss = offending_amount[off_diag_mask].pow(2).mean()

    return loss

