def image_for_visual_level(imgs, level_idx):
    """
    L0: show normal 64x64 image.
    L1: show 16x16 downsampled image, nearest-upsampled to 64x64.
    """
    pyramid = build_image_pyramid(imgs)
    x = pyramid[level_idx]

    if x.shape[-1] != IMAGE_SIZE:
        x = F.interpolate(
            x,
            size=(IMAGE_SIZE, IMAGE_SIZE),
            mode="nearest",
        )

    return x


