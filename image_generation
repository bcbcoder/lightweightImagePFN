    elif feature_family_name == "resnet18":
        feats = resnet_features(x_level, level_idx=level_idx)
        feature_desc = f"ResNet18-{RESNET_STAGES_PER_LEVEL[level_idx]}"

    elif feature_family_name == "gabor":
        feats = gabor_features_by_level[level_idx](x_level)
        feature_desc = "Gabor"

    elif feature_family_name == "dog":
        feats = dog_features_by_level[level_idx](x_level)
        feature_desc = "DoG/blob"

    elif feature_family_name == "fft":
        feats = fft_features_by_level[level_idx](x_level)
        feature_desc = "FFT spectrum"

    elif feature_family_name == "steerable":
        feats = steerable_features_by_level[level_idx](x_level)
        feature_desc = "Steerable gradients"

    elif feature_family_name == "vgg16_early":
        feats = vgg_features(x_level, level_idx=level_idx)
        feature_desc = f"VGG16-early-{VGG_LAYER_CUTOFF_BY_LEVEL[level_idx]}"

    elif feature_family_name == "mobilenet_v3_small":
        feats = mobilenet_features(x_level, level_idx=level_idx)
        feature_desc = f"MobileNetV3S-{MOBILENET_FEATURE_CUTOFF_BY_LEVEL[level_idx]}"

    elif feature_family_name == "color_hsv":
        feats = color_features_by_level[level_idx](x_level)
        feature_desc = "HSV/color"

    elif feature_family_name == "soft_lbp":
        feats = soft_lbp_features_by_level[level_idx](x_level)
        feature_desc = "Soft LBP"

    elif feature_family_name == "shape_edges":
        feats = shape_features_by_level[level_idx](x_level)
