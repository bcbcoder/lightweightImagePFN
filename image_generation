def int_to_centered_vector(y_int):
    """
    Converts integer values to centered values around 0.

    With current settings:
        0    -> -1.0
        1000 ->  0.0
        2000 ->  1.0

    y_int can be [B, 3] or any shape whose values are integer-grid components.
    """
    return (y_int.float() - VECTOR_INT_CENTER) / VECTOR_INT_SCALE


def centered_to_display_int(y_centered):
    return torch.round(y_centered * VECTOR_INT_SCALE + VECTOR_INT_CENTER).long()


def safe_normalize_vector(y):
    """
    Normalizes a D-dimensional chunk for cosine similarity.

    If a vector is accidentally near zero, it becomes [1, 0, 0, ...]
    instead of producing NaNs.
    """
    norm = y.norm(dim=1, keepdim=True)

    fallback = torch.zeros_like(y)
    fallback[:, 0:1] = 1.0

    return torch.where(
        norm > VECTOR_NORM_EPS,
        y / norm.clamp_min(VECTOR_NORM_EPS),
        fallback,
    )


def chunk_start_index(feature_family_idx, level_idx):
    """
    Vector layout:

        [feature family 0 L0 dim0, dim1, dim2]
        [feature family 0 L1 dim0, dim1, dim2]
        [feature family 1 L0 dim0, dim1, dim2]
        ...

    Each chunk is 3D.
    """
    chunk_idx = feature_family_idx * NUM_SCALES + level_idx
    return chunk_idx * DIMS_PER_VECTOR


def get_feature_level_chunk(y, feature_family_idx, level_idx):
    start = chunk_start_index(feature_family_idx, level_idx)
    end = start + DIMS_PER_VECTOR
    return y[:, start:end]


def set_feature_level_chunk(y, feature_family_idx, level_idx, chunk):
    start = chunk_start_index(feature_family_idx, level_idx)
    end = start + DIMS_PER_VECTOR
    y[:, start:end] = chunk
    return y


def make_isolated_feature_level_vector(
    vector_chunk,
    feature_family_idx,
    level_idx,
    vector_dim=VECTOR_DIM,
):
    """
    Makes a zeroed full vector with only one branch/scale 3D chunk active.

    vector_chunk:
        [B, 3]

    Output:
        [B, VECTOR_DIM]
    """
    y = torch.zeros(
        vector_chunk.shape[0],
        vector_dim,
        device=vector_chunk.device,
        dtype=vector_chunk.dtype,
    )

    y = set_feature_level_chunk(
        y=y,
        feature_family_idx=feature_family_idx,
        level_idx=level_idx,
        chunk=vector_chunk,
    )

    return y


def sample_integer_chunk(batch_size, device):
    """
    Samples one 3D integer chunk, centers/scales it to [-1, 1], then avoids
    near-zero vectors because cosine similarity is undefined there.
    """
    y_int = torch.randint(
        low=VECTOR_INT_MIN,
        high=VECTOR_INT_MAX + 1,
        size=(batch_size, DIMS_PER_VECTOR),
        device=device,
    )

    y = int_to_centered_vector(y_int)

    # Rare, but avoid undefined cosine around [0, 0, 0].
    near_zero = y.norm(dim=1) < 0.05

    if near_zero.any():
        n = int(near_zero.sum().item())

        replacement = torch.randn(
            n,
            DIMS_PER_VECTOR,
            device=device,
        )
        replacement = safe_normalize_vector(replacement)

        y[near_zero] = replacement

    return y


def sample_training_vector_chunk(batch_size, device):
    """
    TRAINING ONLY.

    Samples one 3D chunk per image. This same 3D chunk is activated one
    branch/scale at a time inside compute_isolated_branch_losses().
    """
    return sample_integer_chunk(
        batch_size=batch_size,
        device=device,
    )


def sample_random_full_vectors(batch_size, device):
    """
    Helper for experiments. Visualization/training primarily use isolated vectors.
    """
    chunks = []

    for _feature_family_idx in range(NUM_FEATURE_FAMILIES):
        for _level_idx in range(NUM_SCALES):
            chunk = sample_integer_chunk(
                batch_size=batch_size,
                device=device,
            )
            chunks.append(chunk)

    return torch.cat(chunks, dim=1)


def vector_cosine_similarity_matrix(y_chunk):
    """
    Cosine similarity for focused 3D chunks.

    y_chunk: [B, 3]
    output: [B, B] in [-1, 1]
    """
    y_norm = safe_normalize_vector(y_chunk)
    return y_norm @ y_norm.T


def choose_3d_vectors_for_target_similarities(device):
    """
    Chooses exact 3D unit vectors whose cosine similarity to reference
    [1, 0, 0] equals the requested target similarities.

    For target cosine c:
        x = c
        remaining radius = sqrt(1 - c^2)

    The remaining mass is rotated through the y/z plane so the visualization
    actually uses 3D geometry instead of always staying in the x/y plane.
    """
    chosen_centered = []
    chosen_raw = []
    chosen_actual_sim = []

    num_targets = len(VIS_TARGET_SIMILARITIES)

    for idx, target in enumerate(VIS_TARGET_SIMILARITIES):
        c = float(max(-1.0, min(1.0, target)))
        radius = math.sqrt(max(0.0, 1.0 - c * c))

        # Rotate through the orthogonal y/z plane.
        # This keeps dot([1,0,0], vec) = c while using all 3 dimensions.
        phi = 2.0 * math.pi * float(idx) / max(float(num_targets), 1.0)

        y_val = radius * math.cos(phi)
        z_val = radius * math.sin(phi)

        vec = torch.tensor(
            [c, y_val, z_val],
            device=device,
            dtype=torch.float32,
        )

        raw = centered_to_display_int(vec)

        chosen_centered.append(vec)
        chosen_raw.append(raw)
        chosen_actual_sim.append(torch.tensor(c, device=device, dtype=torch.float32))

    chosen_centered = torch.stack(chosen_centered, dim=0)
    chosen_raw = torch.stack(chosen_raw, dim=0)
    chosen_actual_sim = torch.stack(chosen_actual_sim, dim=0)

    return chosen_centered, chosen_raw, chosen_actual_sim


def branch_level_weight(feature_family_name, level_idx):
    feature_weight = float(FEATURE_FAMILY_LOSS_WEIGHTS[feature_family_name])
    level_weight = float(LEVEL_LOSS_WEIGHTS[level_idx])
    return feature_weight * level_weight


