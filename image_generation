def make_branch_scale_similarity_grid(
    generator,
    z_dim,
    device,
    title="Generated images: rows=branch/scale, columns=target 3D cosine similarity",
    save_path=None,
):
    """
    Makes a 26 x 18 grid.

    Rows:
        13 feature families * 2 scales

    For each row:
        - the full VECTOR_DIM vector is zero
        - only the row's branch/scale 3D chunk is active
        - one fixed z is used across that row
        - lower-scale rows are displayed at that lower scale, nearest-upsampled
    """
    generator.eval()

    chosen_centered, chosen_raw, chosen_actual_sim = choose_3d_vectors_for_target_similarities(
        device=device,
    )

    rows = NUM_FEATURE_FAMILIES * NUM_SCALES
    cols = len(VIS_TARGET_SIMILARITIES)

    all_y = []
    all_z = []
    labels = []

    z_by_row = [
        torch.randn(1, z_dim, device=device)
        for _ in range(rows)
    ]

    row_idx = 0

    for feature_family_idx, feature_family_name in enumerate(FEATURE_FAMILIES):
        for level_idx in range(NUM_SCALES):
            for col_idx in range(cols):
                vector_chunk = chosen_centered[col_idx].view(1, DIMS_PER_VECTOR)

                y = make_isolated_feature_level_vector(
                    vector_chunk=vector_chunk,
                    feature_family_idx=feature_family_idx,
                    level_idx=level_idx,
                )

                z = z_by_row[row_idx].clone()

                all_y.append(y)
                all_z.append(z)

                raw_triplet = chosen_raw[col_idx].detach().cpu().view(-1).tolist()
                centered_triplet = chosen_centered[col_idx].detach().cpu().view(-1).tolist()

                labels.append({
                    "row_idx": row_idx,
                    "feature_family_idx": feature_family_idx,
                    "feature_family": feature_family_name,
                    "level_idx": level_idx,
                    "resolution": RESOLUTION_LEVELS[level_idx],
                    "target_sim": VIS_TARGET_SIMILARITIES[col_idx],
                    "actual_sim": float(chosen_actual_sim[col_idx].detach().cpu().item()),
                    "raw_triplet": [
                        int(raw_triplet[0]),
                        int(raw_triplet[1]),
                        int(raw_triplet[2]),
                    ],
                    "centered_triplet": [
                        float(centered_triplet[0]),
                        float(centered_triplet[1]),
                        float(centered_triplet[2]),
                    ],
                })

            row_idx += 1

    y = torch.cat(all_y, dim=0)
    z = torch.cat(all_z, dim=0)

    with torch.no_grad():
        imgs = generator(z, y)

        imgs_display = []

        for row_idx in range(rows):
            start = row_idx * cols
            end = start + cols

            row_labels = labels[start:end]
            level_idx = row_labels[0]["level_idx"]

            imgs_row = imgs[start:end]
            imgs_row_vis = image_for_visual_level(
                imgs_row,
                level_idx=level_idx,
            )

            imgs_display.append(imgs_row_vis)

        imgs_display = torch.cat(imgs_display, dim=0)

    imgs_vis = (imgs_display.clamp(-1, 1) + 1.0) / 2.0
    imgs_vis = imgs_vis.detach().cpu()

    fig = plt.figure(figsize=(cols * 1.45, rows * 1.75))
    fig.suptitle(title, fontsize=14)

    for idx, label in enumerate(labels):
        row = label["row_idx"]
        col = idx % cols
        plot_idx = row * cols + col + 1

        img = imgs_vis[idx].permute(1, 2, 0).numpy()

        ax = plt.subplot(rows, cols, plot_idx)
        ax.imshow(img)
        ax.axis("off")

        if row == 0:
            rt = label["raw_triplet"]
            ax.set_title(
                f"cos {label['actual_sim']:+.3f}\n"
                f"raw=({rt[0]},{rt[1]},{rt[2]})",
                fontsize=6,
            )

        if col == 0:
            feature_desc = feature_label_for_row(label["feature_family"], label["level_idx"])
            resolution = label["resolution"]

            ax.set_ylabel(
                f"{feature_desc}\n"
                f"L{label['level_idx']}\n"
                f"{resolution}x{resolution}",
                fontsize=7,
                rotation=0,
                labelpad=42,
                va="center",
            )

    plt.tight_layout()

    if save_path is not None:
        save_dir = os.path.dirname(save_path)
        if save_dir:
            os.makedirs(save_dir, exist_ok=True)

        plt.savefig(save_path, dpi=150, bbox_inches="tight")
        plt.close(fig)
        print(f"Saved sample visualization: {save_path}")
    else:
        plt.show()
