        FrozenCurvatureHessianFeatures(
            blur_kernel_size=CURVATURE_BLUR_KERNEL_SIZE_BY_LEVEL[level_idx],
            blur_sigma=CURVATURE_BLUR_SIGMA_BY_LEVEL[level_idx],
            pooled_size=CURVATURE_POOLED_SIZE_BY_LEVEL[level_idx],
            include_signed=CURVATURE_INCLUDE_SIGNED_BY_LEVEL[level_idx],
            eps=CURVATURE_EPS,
        )
        for level_idx in range(NUM_SCALES)
    ]).to(DEVICE)

    for curvature_hessian_features in curvature_hessian_features_by_level:
        curvature_hessian_features.eval()
        for p in curvature_hessian_features.parameters():
            p.requires_grad = False

    optimizer = torch.optim.AdamW(
        generator.parameters(),
        lr=LR,
        weight_decay=WEIGHT_DECAY,
    )

    print("Saving initial isolated branch/scale 2D-cosine grid:")
    make_branch_scale_similarity_grid(
        generator=generator,
        z_dim=Z_DIM,
        device=DEVICE,
        title="Before training: isolated rows=branch/scale, columns=target 2D cosine similarity",
        save_path=os.path.join(SAMPLE_SAVE_DIR, "samples_step_0000_initial.png"),
    )

    save_generator_checkpoint(
        generator=generator,
        optimizer=optimizer,
        step=0,
        save_dir=CHECKPOINT_SAVE_DIR,
        filename="generator_step_0000_initial.pth",
    )

    for step in range(NUM_STEPS):
        out = train_step(
            generator=generator,
            frozen_prior_generator=frozen_prior_generator,
            hog_features_by_level=hog_features_by_level,
            resnet_features=resnet_features,
            gabor_features_by_level=gabor_features_by_level,
            dog_features_by_level=dog_features_by_level,
            fft_features_by_level=fft_features_by_level,
            steerable_features_by_level=steerable_features_by_level,
            vgg_features=vgg_features,
            mobilenet_features=mobilenet_features,
            color_features_by_level=color_features_by_level,
            soft_lbp_features_by_level=soft_lbp_features_by_level,
            shape_features_by_level=shape_features_by_level,
            soft_contour_features_by_level=soft_contour_features_by_level,
            curvature_hessian_features_by_level=curvature_hessian_features_by_level,
            optimizer=optimizer,
            batch_size=BATCH_SIZE,
            z_dim=Z_DIM,
            device=DEVICE,
        )

        if step % 10 == 0:
            log_msg = " | ".join(
                [
                    (
                        f"{log['feature_family']} "
                        f"L{log['level_idx']}@{log['resolution']} "
                        f"w {log['combined_weight']:.3f}: "
                        f"rel {log['rel_loss']:.4f}, "
                        f"pattern_div {log['pattern_diversity_penalty']:.4f}, "
                        f"prior {log['prior_loss']:.4f}, "
                        f"sim_img {log['avg_img_sim']:.3f}, "
                        f"sim_y {log['avg_vector_sim']:.3f}, "
                        f"ceil {log['avg_diversity_ceiling']:.3f}"
                    )
                    for log in out["logs"]
                ]
            )

            print(
                f"step {step:05d} | "
                f"total {out['total_loss']:.6f} | "
                f"rel {out['rel_loss']:.6f} | "
                f"pattern_div {out['pattern_diversity_penalty']:.6f} | "
                f"prior {out['prior_loss']:.6f} | "
                f"{log_msg}"
            )

        if step > 0 and step % VIS_EVERY == 0:
            make_branch_scale_similarity_grid(
                generator=generator,
                z_dim=Z_DIM,
                device=DEVICE,
                title=f"After {step} steps: isolated rows=branch/scale, columns=target 2D cosine similarity",
                save_path=os.path.join(
                    SAMPLE_SAVE_DIR,
                    f"samples_step_{step:05d}.png",
                ),
            )

            save_generator_checkpoint(
                generator=generator,
                optimizer=optimizer,
                step=step,
                save_dir=CHECKPOINT_SAVE_DIR,
                filename=f"generator_step_{step:05d}.pth",
            )

    print("Saving final isolated branch/scale 2D-cosine grid:")
    make_branch_scale_similarity_grid(
        generator=generator,
        z_dim=Z_DIM,
        device=DEVICE,
        title="Final: isolated rows=branch/scale, columns=target 2D cosine similarity",
        save_path=os.path.join(SAMPLE_SAVE_DIR, "samples_step_final.png"),
    )

    save_generator_checkpoint(
        generator=generator,
        optimizer=optimizer,
        step=NUM_STEPS,
        save_dir=CHECKPOINT_SAVE_DIR,
        filename="generator_step_final.pth",
    )

    final_path = "integer_multiscale_11branch_3d_cosine_isolated_relational_checkpoint.pth"
    torch.save(
        checkpoint_payload(generator, optimizer, NUM_STEPS),
        final_path,
    )

    print(f"Saved checkpoint: {final_path}")
