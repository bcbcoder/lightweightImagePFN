    else:
        raise ValueError(f"Unknown feature family: {feature_family_name}")

    return feats, feature_desc


def compute_isolated_branch_losses(
    generator,
    frozen_prior_generator,
    z,
    base_vector_chunk,
    hog_features_by_level,
    resnet_features,
    gabor_features_by_level,
    dog_features_by_level,
    fft_features_by_level,
    steerable_features_by_level,
    vgg_features,
    mobilenet_features,
    color_features_by_level,
    soft_lbp_features_by_level,
    shape_features_by_level,
    soft_contour_features_by_level,
    curvature_hessian_features_by_level,
):
    """
    Main training logic.

    For each branch/scale:
        - create isolated y with only that 2D chunk active
        - generate isolated image
        - compute this branch/scale's feature loss on that isolated image
        - compute branch-local diversity using only that 2D cosine target
        - compute branch-local style prior against frozen prior generator
    """
    total_rel_loss = 0.0
    total_pattern_div_loss = 0.0
    total_prior_loss = 0.0

    logs = []

    composite_imgs = None
    total_composite_weight = 0.0

    sim_y = vector_cosine_similarity_matrix(base_vector_chunk)

    for feature_family_idx, feature_family_name in enumerate(FEATURE_FAMILIES):
        feature_weight = float(FEATURE_FAMILY_LOSS_WEIGHTS[feature_family_name])

        for level_idx in range(NUM_SCALES):
            level_weight = float(LEVEL_LOSS_WEIGHTS[level_idx])
            combined_weight = feature_weight * level_weight

            y_isolated = make_isolated_feature_level_vector(
                vector_chunk=base_vector_chunk,
                feature_family_idx=feature_family_idx,
                level_idx=level_idx,
            )

            imgs_isolated = generator(z, y_isolated)

            with torch.no_grad():
                prior_imgs_isolated = frozen_prior_generator(z, y_isolated)

            prior_loss_l = F.mse_loss(
                imgs_isolated,
                prior_imgs_isolated,
            )

            pyramid = build_image_pyramid(imgs_isolated)
            x_level = pyramid[level_idx]

            feats, feature_desc = extract_features_for_branch_scale(
                x_level=x_level,
                feature_family_name=feature_family_name,
                level_idx=level_idx,
                hog_features_by_level=hog_features_by_level,
                resnet_features=resnet_features,
                gabor_features_by_level=gabor_features_by_level,
                dog_features_by_level=dog_features_by_level,
                fft_features_by_level=fft_features_by_level,
                steerable_features_by_level=steerable_features_by_level,
                vgg_features=vgg_features,
                mobilenet_features=mobilenet_features,
                color_features_by_level=color_features_by_level,
                soft_lbp_features_by_level=soft_lbp_features_by_level,
                shape_features_by_level=shape_features_by_level,
                soft_contour_features_by_level=soft_contour_features_by_level,
                curvature_hessian_features_by_level=curvature_hessian_features_by_level,
            )

            sim_img = cosine_similarity_matrix(feats)

            rel_loss_l = relational_loss_from_similarities(
                sim_img=sim_img,
                sim_y=sim_y,
            )

            pattern_div_loss_l = pattern_diversity_penalty(
                sim_img=sim_img,
                sim_y=sim_y,
            )

            total_rel_loss = total_rel_loss + combined_weight * rel_loss_l
            total_pattern_div_loss = total_pattern_div_loss + combined_weight * pattern_div_loss_l
            total_prior_loss = total_prior_loss + combined_weight * prior_loss_l

            if composite_imgs is None:
                composite_imgs = combined_weight * imgs_isolated
            else:
                composite_imgs = composite_imgs + combined_weight * imgs_isolated

            total_composite_weight += combined_weight

            with torch.no_grad():
                ceiling = relative_diversity_ceiling(sim_y)
                off_diag_mask = ~torch.eye(
                    sim_img.shape[0],
                    dtype=torch.bool,
                    device=sim_img.device,
                )

                avg_img_sim = float(sim_img[off_diag_mask].mean().item())
                avg_vec_sim = float(sim_y[off_diag_mask].mean().item())
                avg_div_ceiling = float(ceiling[off_diag_mask].mean().item())

            logs.append({
                "feature_family_idx": feature_family_idx,
                "feature_family": feature_family_name,
                "feature_desc": feature_desc,
                "feature_weight": feature_weight,

                "level_idx": level_idx,
                "resolution": RESOLUTION_LEVELS[level_idx],
                "downsample_steps": DOWNSAMPLE_STEPS_PER_LEVEL[level_idx],
                "level_weight": level_weight,

                "combined_weight": combined_weight,
                "rel_loss": float(rel_loss_l.item()),
                "pattern_diversity_penalty": float(pattern_div_loss_l.item()),
                "prior_loss": float(prior_loss_l.item()),
                "avg_img_sim": avg_img_sim,
                "avg_vector_sim": avg_vec_sim,
                "avg_diversity_ceiling": avg_div_ceiling,
                "sim_img": sim_img.detach(),
                "sim_y": sim_y.detach(),
            })

    if total_composite_weight > 0:
        composite_imgs = composite_imgs / float(total_composite_weight)

    return total_rel_loss, total_pattern_div_loss, total_prior_loss, composite_imgs, logs


# ============================================================
# Training step
# ============================================================

def train_step(
    generator,
    frozen_prior_generator,
    hog_features_by_level,
    resnet_features,
    gabor_features_by_level,
    dog_features_by_level,
    fft_features_by_level,
    steerable_features_by_level,
    vgg_features,
    mobilenet_features,
    color_features_by_level,
    soft_lbp_features_by_level,
    shape_features_by_level,
    soft_contour_features_by_level,
    curvature_hessian_features_by_level,
    optimizer,
    batch_size,
    z_dim,
    device,
):
    generator.train()
    frozen_prior_generator.eval()

    for module_list in [
        hog_features_by_level,
        gabor_features_by_level,
        dog_features_by_level,
        fft_features_by_level,
        steerable_features_by_level,
        color_features_by_level,
        soft_lbp_features_by_level,
        shape_features_by_level,
        soft_contour_features_by_level,
        curvature_hessian_features_by_level,

    ]:
        for module in module_list:
            module.eval()

    resnet_features.eval()
    vgg_features.eval()
    mobilenet_features.eval()

    z = torch.randn(batch_size, z_dim, device=device)

    # One 2D chunk per image. This chunk is activated one branch/scale at a time.
    base_vector_chunk = sample_training_vector_chunk(
        batch_size=batch_size,
        device=device,
    )

    rel_loss, pattern_div_penalty, prior_loss, composite_imgs, logs = compute_isolated_branch_losses(
        generator=generator,
        frozen_prior_generator=frozen_prior_generator,
        z=z,
        base_vector_chunk=base_vector_chunk,
        hog_features_by_level=hog_features_by_level,
        resnet_features=resnet_features,
        gabor_features_by_level=gabor_features_by_level,
        dog_features_by_level=dog_features_by_level,
        fft_features_by_level=fft_features_by_level,
        steerable_features_by_level=steerable_features_by_level,
        vgg_features=vgg_features,
        mobilenet_features=mobilenet_features,
        color_features_by_level=color_features_by_level,
        soft_lbp_features_by_level=soft_lbp_features_by_level,
        shape_features_by_level=shape_features_by_level,
        soft_contour_features_by_level=soft_contour_features_by_level,
        curvature_hessian_features_by_level=curvature_hessian_features_by_level,
    )

    total_loss = (
        RELATIONAL_LOSS_WEIGHT * rel_loss
        + PATTERN_DIVERSITY_WEIGHT * pattern_div_penalty
        + STYLE_PRIOR_WEIGHT * prior_loss
    )

    optimizer.zero_grad(set_to_none=True)
    total_loss.backward()
    optimizer.step()

    return {
        "total_loss": float(total_loss.item()),
        "rel_loss": float(rel_loss.item()),
        "pattern_diversity_penalty": float(pattern_div_penalty.item()),
        "prior_loss": float(prior_loss.item()),
        "imgs": composite_imgs.detach(),
        "base_vector_chunk": base_vector_chunk.detach(),
        "logs": logs,
    }


