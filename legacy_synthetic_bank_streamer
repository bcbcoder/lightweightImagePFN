import torch
import torch.nn as nn
import torch.nn.functional as F



NUM_FEATURE_BRANCHES = 13
NUM_SCALES = 2
DIMS_PER_SUBVECTOR = 8

CONDITION_VECTOR_DIM = NUM_FEATURE_BRANCHES * NUM_SCALES * DIMS_PER_SUBVECTOR

# Current baseline checkpoint architecture defaults.
DEFAULT_Z_DIM = 256
DEFAULT_IMAGE_SIZE = 64
DEFAULT_BASE_CHANNELS = 384

# Must match training integer-vector setup.
VECTOR_INT_MIN = 0
VECTOR_INT_MAX = 2000
VECTOR_INT_CENTER = 1000.0
VECTOR_INT_SCALE = 1000.0
VECTOR_NORM_EPS = 1e-6
NEAR_ZERO_VECTOR_NORM = 0.05


def int_to_centered_vector(y_int):
    """
    Converts integer-grid values to centered values.

    With current settings:
        0    -> -1.0
        1000 ->  0.0
        2000 ->  1.0
    """
    return (y_int.float() - VECTOR_INT_CENTER) / VECTOR_INT_SCALE


def safe_normalize_vector(y, eps=VECTOR_NORM_EPS):
    """
    Normalizes a vector safely.

    Only used for near-zero replacement, matching training.
    We do NOT normalize every sampled vector.
    """
    norm = y.norm(dim=1, keepdim=True)

    fallback = torch.zeros_like(y)
    fallback[:, 0:1] = 1.0

    return torch.where(
        norm > eps,
        y / norm.clamp_min(eps),
        fallback,
    )


def sample_training_style_active_subvectors(
    batch_size,
    dims_per_subvector,
    device,
    generator=None,
):
    """
    Matches the training vector-chunk sampling exactly.

    Training behavior:
        y_int = randint(0, 2000)
        y = (y_int - 1000) / 1000

    Then:
        if norm(y) < 0.05:
            replace with a random unit direction

    Important:
        We do NOT normalize every active subvector.
        Magnitudes remain training-like.
    """
    y_int = torch.randint(
        low=VECTOR_INT_MIN,
        high=VECTOR_INT_MAX + 1,
        size=(batch_size, dims_per_subvector),
        device=device,
        generator=generator,
    )

    chunks = int_to_centered_vector(y_int)

    near_zero = chunks.norm(dim=1) < NEAR_ZERO_VECTOR_NORM

    if near_zero.any():
        n = int(near_zero.sum().item())

        replacement = torch.randn(
            n,
            dims_per_subvector,
            device=device,
            generator=generator,
        )
        replacement = safe_normalize_vector(replacement)

        chunks[near_zero] = replacement

    return chunks


def sample_single_active_subvector_vectors(
    batch_size,
    num_feature_branches,
    num_scales,
    dims_per_subvector,
    device,
    generator=None,
):
    """
    Samples full conditioning vectors with exactly one active aligned subvector.

    Full vector shape:
        [B, num_feature_branches * num_scales * dims_per_subvector]

    Current default:
        [B, 13 * 2 * 3] = [B, 78]

    Important:
        Active chunks are always aligned to multiples of dims_per_subvector.
        So there is no cross-contamination between neighboring chunks.

    Example with dims_per_subvector=3:
        valid starts: 0, 3, 6, 9, ...
        invalid starts: 1, 2, 4, 5, ...

    Active subvector values match training sampling:
        integer-centered values in roughly [-1, 1],
        with only near-zero vectors replaced.
    """
    vector_dim = num_feature_branches * num_scales * dims_per_subvector
    num_chunks = num_feature_branches * num_scales

    vectors = torch.zeros(
        batch_size,
        vector_dim,
        device=device,
    )

    active_chunk_indices = torch.randint(
        low=0,
        high=num_chunks,
        size=(batch_size,),
        device=device,
        generator=generator,
    )

    active_subvectors = sample_training_style_active_subvectors(
        batch_size=batch_size,
        dims_per_subvector=dims_per_subvector,
        device=device,
        generator=generator,
    )

    # Vectorized placement.
    # Each start is guaranteed to be a multiple of dims_per_subvector.
    starts = active_chunk_indices * dims_per_subvector
    offsets = torch.arange(dims_per_subvector, device=device).view(1, -1)
    cols = starts.view(-1, 1) + offsets
    rows = torch.arange(batch_size, device=device).view(-1, 1)

    vectors[rows, cols] = active_subvectors

    return vectors, active_chunk_indices, active_subvectors


